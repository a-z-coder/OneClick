#!/usr/bin/env bash
set -Eeuo pipefail

# Debian 13：按配置生成 Reality、CDN XHTTP-TLS 和 HY2 节点。
SCRIPT_VERSION="1.1.0"
SCRIPT_NAME="$(basename "${0:-Debian13-oneclick.sh}")"
OUTPUT_DIR="/etc/xray"
CONFIG_PATH="$OUTPUT_DIR/config.json"
SUB_ROOT="/var/lib/xray-yijian/sub"
TMP_DIR=""
XRAY_BIN=""
NGINX_BIN=""
declare -A CONFIG_VALUES=()
declare -a NODE_IDS=() HY2_IDS=()
declare -a NODE_TYPES=() NODE_PORTS=() NODE_ENTRY_IPS=() NODE_EXIT_IPS=()
declare -a NODE_NAMES=() NODE_IP_FAMILIES=() NODE_EXIT_FAMILIES=()
declare -a NODE_HY2_STARTS=() NODE_HY2_ENDS=() NODE_HY2_PASSWORDS=()
declare -a NEW_INBOUNDS=() NEW_OUTBOUNDS=() NEW_RULES=() NODE_LINES=()

cleanup() {
  if [[ -n "$TMP_DIR" && -d "$TMP_DIR" ]]; then
    rm -f -- "$TMP_DIR"/* 2>/dev/null || true
    rmdir -- "$TMP_DIR" 2>/dev/null || true
  fi
}
trap cleanup EXIT

die() {
  printf '[失败] %s\n' "$*" >&2
  exit 1
}
info() {
  printf '[信息] %s\n' "$*"
}
ok() {
  printf '[成功] %s\n' "$*"
}
command_exists() {
  command -v "$1" >/dev/null 2>&1
}
trim_value() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}
config_value() {
  printf '%s' "${CONFIG_VALUES[$1]:-}"
}
required_value() {
  local key="$1"
  local value="${CONFIG_VALUES[$key]:-}"
  [[ -n "$value" ]] || die "配置中缺少 $key"
  printf '%s' "$value"
}
extract_pem_block() {
  local begin="$1" end="$2"
  printf '%s\n' "$CONFIG_INPUT" | awk -v begin="$begin" -v end="$end" '
    $0 == begin { capture = 1; next }
    capture && $0 == end { found = 1; exit }
    capture { print }
    END { if (!found) exit 1 }
  '
}

read_deployment_config() {
  local line key value pem="" field node_index=0 has_cert=0 has_key=0
  printf '请粘贴从 YIjian_CONFIG_BEGIN 到 YIjian_CONFIG_END 的完整配置；每次 NODE_TYPE 开始一个新节点，节点字段使用无编号名称：\n' >&2
  CONFIG_INPUT="$(awk '
    {
      sub(/\r$/, "")
      if ($0 == "YIjian_CONFIG_BEGIN") { started = 1; next }
      if ($0 == "YIjian_CONFIG_END") {
        if (started) found = 1
        exit
      }
      if (started && $0 != "```") print
    }
    END { if (!started || !found) exit 1 }
  ')" || die "配置必须包含 YIjian_CONFIG_BEGIN 和 YIjian_CONFIG_END"

  while IFS= read -r line; do
    line="$(trim_value "$line")"
    [[ -n "$line" ]] || continue
    if [[ -n "$pem" ]]; then
      [[ "$line" == "${pem}_END" ]] && pem=""
      continue
    fi
    case "$line" in
      CERTIFICATE_BEGIN) pem="CERTIFICATE"; continue ;;
      PRIVATE_KEY_BEGIN) pem="PRIVATE_KEY"; continue ;;
      \#*) continue ;;
    esac
    [[ "$line" =~ ^([A-Z0-9_]+)=(.*)$ ]] || die "无法识别的配置行：$line"
    key="${BASH_REMATCH[1]}"
    value="$(trim_value "${BASH_REMATCH[2]}")"
    if [[ "$key" =~ ^NODE_(TYPE|PORT|PORT_RANGE|ENTRY_IP|EXIT_IP|NAME|PREFERRED_DOMAIN|ORIGIN_DOMAIN|SNI|PASSWORD)$ ]]; then
      field="${BASH_REMATCH[1]}"
      if [[ "$field" == TYPE ]]; then
        if (( node_index == 0 )); then
          node_index=1
        else
          node_index=$((node_index + 1))
        fi
      elif (( node_index == 0 )); then
        die "NODE_TYPE 必须放在每个节点配置的第一行"
      fi
      key="NODE_${node_index}_${field}"
    elif [[ "$key" != SUBSCRIPTION_MODE && "$key" != SUB_DOMAIN && "$key" != SUB_IP && "$key" != SUB_PORT && "$key" != SUB_TOKEN ]]; then
      die "未知配置项：$key；节点配置请使用 NODE_TYPE、NODE_PORT 等无编号字段"
    fi
    [[ -z "${CONFIG_VALUES[$key]+x}" ]] || die "配置项重复：$key"
    CONFIG_VALUES["$key"]="$value"
  done <<< "$CONFIG_INPUT"
  [[ -z "$pem" ]] || die "证书或私钥区块缺少结束标记"
  [[ "$CONFIG_INPUT" == *CERTIFICATE_BEGIN* ]] && has_cert=1
  [[ "$CONFIG_INPUT" == *PRIVATE_KEY_BEGIN* ]] && has_key=1
  (( has_cert == has_key )) || die "证书和私钥必须同时提供"
  if (( has_cert == 1 )); then
    CERT_CONTENT="$(extract_pem_block CERTIFICATE_BEGIN CERTIFICATE_END)" || die "证书区块不完整"
    KEY_CONTENT="$(extract_pem_block PRIVATE_KEY_BEGIN PRIVATE_KEY_END)" || die "私钥区块不完整"
    [[ -n "$CERT_CONTENT" && -n "$KEY_CONTENT" ]] || die "证书或私钥区块为空"
  else
    CERT_CONTENT=""
    KEY_CONTENT=""
  fi
}

validate_port() {
  local label="$1" value="$2"
  [[ "$value" =~ ^[1-9][0-9]{0,4}$ ]] || die "$label 必须是 1 到 65535 的十进制整数"
  (( value <= 65535 )) || die "$label 超出 1 到 65535 的范围"
}
validate_domain() {
  local label="$1" value="$2" part
  local -a parts=()
  (( ${#value} <= 253 )) || die "$label 过长：$value"
  [[ "$value" == *.* ]] || die "$label 必须是完整域名：$value"
  IFS='.' read -r -a parts <<< "$value"
  for part in "${parts[@]}"; do
    (( ${#part} <= 63 )) || die "$label 的标签过长：$value"
    [[ "$part" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || die "$label 格式不正确：$value"
  done
  [[ "$value" != *..* && "$value" != *. ]] || die "$label 格式不正确：$value"
}
validate_ipv4() {
  local value="$1" octet
  local -a octets=()
  [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS='.' read -r -a octets <<< "$value"
  for octet in "${octets[@]}"; do
    [[ "$octet" == 0 || "$octet" != 0* ]] || return 1
    (( 10#$octet <= 255 )) || return 1
  done
}
validate_ipv6() {
  local value="$1" rest group count=0
  [[ "$value" == *:* && "$value" =~ ^[0-9A-Fa-f:]+$ && "$value" != *:::* ]] || return 1
  [[ "$value" != :* || "$value" == ::* ]] || return 1
  [[ "$value" != *: || "$value" == *:: ]] || return 1
  if [[ "$value" == *::* ]]; then
    rest="${value#*::}"
    [[ "$rest" != *::* ]] || return 1
  fi
  rest="$value"
  while [[ -n "$rest" ]]; do
    if [[ "$rest" == *:* ]]; then
      group="${rest%%:*}"
      rest="${rest#*:}"
    else
      group="$rest"
      rest=""
    fi
    if [[ -n "$group" ]]; then
      [[ "$group" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
      count=$((count + 1))
    fi
  done
  if [[ "$value" == *::* ]]; then
    (( count < 8 ))
  else
    (( count == 8 ))
  fi
}
ip_family() {
  if validate_ipv4 "$1"; then
    printf '4'
  elif validate_ipv6 "$1"; then
    printf '6'
  else
    return 1
  fi
}
url_host() {
  if [[ "$1" == *:* ]]; then printf '[%s]' "$1"; else printf '%s' "$1"; fi
}
urlencode() {
  jq -nr --arg value "$1" '$value | @uri'
}

validate_deployment_config() {
  local index prefix type port entry exit range start end password key field
  local subscription_mode subscription_ip_family
  local expected=1 other
  local -a raw_indices=()
  declare -A used_ports=()
  CERT_REQUIRED=0
  SUBSCRIPTION_ENABLED=0
  SUB_HOST=""
  SUB_HOST_FAMILY=""

  for key in "${!CONFIG_VALUES[@]}"; do
    if [[ "$key" =~ ^NODE_([1-9][0-9]*)_ ]]; then
      raw_indices+=("${BASH_REMATCH[1]}")
    fi
  done
  (( ${#raw_indices[@]} > 0 )) || die "配置中没有节点"
  mapfile -t NODE_IDS < <(printf '%s\n' "${raw_indices[@]}" | sort -nu)
  for index in "${NODE_IDS[@]}"; do
    [[ "$index" == "$expected" ]] || die "节点编号必须从 1 连续递增，缺少 NODE_${expected}"
    expected=$((expected + 1))
  done

  for index in "${NODE_IDS[@]}"; do
    prefix="NODE_${index}"
    type="$(required_value "${prefix}_TYPE")"
    NODE_NAMES[$index]="$(required_value "${prefix}_NAME")"
    NODE_TYPES[$index]="$type"
    port=""
    entry=""
    exit=""

    for key in "${!CONFIG_VALUES[@]}"; do
      [[ "$key" == "${prefix}_"* ]] || continue
      field="${key#"${prefix}_"}"
      case "$type" in
        REALITY)
          case "$field" in TYPE|PORT|ENTRY_IP|EXIT_IP|NAME) ;; *) die "节点 $index 的 REALITY 不使用 $field" ;; esac
          ;;
        CDN)
          case "$field" in TYPE|PORT|PREFERRED_DOMAIN|ORIGIN_DOMAIN|NAME) ;; *) die "节点 $index 的 CDN 不使用 $field" ;; esac
          ;;
        HY2)
          case "$field" in TYPE|PORT_RANGE|ENTRY_IP|EXIT_IP|SNI|PASSWORD|NAME) ;; *) die "节点 $index 的 HY2 不使用 $field" ;; esac
          ;;
        *) die "节点 $index 的 TYPE 只能是 REALITY、CDN 或 HY2" ;;
      esac
    done

    case "$type" in
      REALITY)
        port="$(required_value "${prefix}_PORT")"
        validate_port "节点 $index 的 Reality 端口" "$port"
        entry="$(required_value "${prefix}_ENTRY_IP")"
        exit="$(required_value "${prefix}_EXIT_IP")"
        ;;
      CDN)
        port="$(required_value "${prefix}_PORT")"
        validate_port "节点 $index 的 CDN 端口" "$port"
        preferred="$(required_value "${prefix}_PREFERRED_DOMAIN")"
        origin="$(required_value "${prefix}_ORIGIN_DOMAIN")"
        validate_domain "节点 $index 的优选域名" "$preferred"
        validate_domain "节点 $index 的源站域名" "$origin"
        case "$port" in
          443|2053|2083|2087|2096|8443) ;;
          *) die "节点 $index 的 CDN 端口必须是 Cloudflare 支持的 HTTPS 端口" ;;
        esac
        ;;
      HY2)
        range="$(required_value "${prefix}_PORT_RANGE")"
        [[ "$range" =~ ^([1-9][0-9]{0,4}):([1-9][0-9]{0,4})$ ]] || die "节点 $index 的 PORT_RANGE 必须是 起始端口:结束端口"
        start="${BASH_REMATCH[1]}"
        end="${BASH_REMATCH[2]}"
        validate_port "节点 $index 的 HY2 范围起始端口" "$start"
        validate_port "节点 $index 的 HY2 范围结束端口" "$end"
        (( end > start )) || die "节点 $index 的 HY2 结束端口必须大于起始端口"
        port="$start"
        NODE_HY2_STARTS[$index]="$start"
        NODE_HY2_ENDS[$index]="$end"
        HY2_IDS+=("$index")
        entry="$(required_value "${prefix}_ENTRY_IP")"
        exit="$(required_value "${prefix}_EXIT_IP")"
        sni="$(required_value "${prefix}_SNI")"
        validate_domain "节点 $index 的 HY2 SNI" "$sni"
        password="$(required_value "${prefix}_PASSWORD")"
        if [[ "$password" != AUTO ]]; then
          [[ "$password" =~ ^[A-Za-z0-9._~-]{8,128}$ ]] || die "节点 $index 的 HY2 密码必须是 AUTO 或至少 8 位安全字符"
        fi
        NODE_HY2_PASSWORDS[$index]="$password"
        ;;
      *) die "节点 $index 的 TYPE 只能是 REALITY、CDN 或 HY2" ;;
    esac
    if [[ "$type" == CDN || "$type" == HY2 ]]; then
      CERT_REQUIRED=1
    fi

    NODE_PORTS[$index]="$port"
    if [[ "$type" == REALITY || "$type" == HY2 ]]; then
      NODE_ENTRY_IPS[$index]="$entry"
      NODE_EXIT_IPS[$index]="$exit"
      NODE_IP_FAMILIES[$index]="$(ip_family "$entry")" || die "节点 $index 的入口 IP 无效：$entry"
      NODE_EXIT_FAMILIES[$index]="$(ip_family "$exit")" || die "节点 $index 的出口 IP 无效：$exit"
      [[ "$entry" != "0.0.0.0" && "$entry" != "::" ]] || die "节点 $index 的入口 IP 不能是未指定地址"
      [[ "$exit" != "0.0.0.0" && "$exit" != "::" ]] || die "节点 $index 的出口 IP 不能是未指定地址"
    fi
    [[ -z "${used_ports[$port]+x}" ]] || die "节点 $index 的端口 $port 与节点 ${used_ports[$port]} 重复"
    used_ports["$port"]="$index"
  done

  subscription_mode="$(config_value SUBSCRIPTION_MODE)"
  if [[ -z "$subscription_mode" ]]; then
    if [[ -n "${CONFIG_VALUES[SUB_DOMAIN]+x}" ]]; then
      subscription_mode="DOMAIN"
    else
      subscription_mode="NONE"
    fi
  fi
  SUB_DOMAIN=""
  SUB_IP=""
  SUB_PORT=""
  SUB_TOKEN=""
  case "$subscription_mode" in
    NONE)
      for key in SUB_DOMAIN SUB_IP SUB_PORT SUB_TOKEN; do
        [[ -z "${CONFIG_VALUES[$key]+x}" ]] || die "SUBSCRIPTION_MODE=NONE 时不能配置 $key"
      done
      SUB_DOMAIN=""
      SUB_IP=""
      SUB_PORT=""
      SUB_TOKEN=""
      ;;
    DOMAIN)
      [[ -z "${CONFIG_VALUES[SUB_IP]+x}" ]] || die "SUBSCRIPTION_MODE=DOMAIN 不使用 SUB_IP"
      SUB_DOMAIN="$(required_value SUB_DOMAIN)"
      SUB_PORT="$(required_value SUB_PORT)"
      SUB_TOKEN="$(required_value SUB_TOKEN)"
      validate_domain "订阅域名" "$SUB_DOMAIN"
      validate_port "HTTPS 订阅端口" "$SUB_PORT"
      SUB_HOST="$SUB_DOMAIN"
      SUBSCRIPTION_ENABLED=1
      CERT_REQUIRED=1
      ;;
    IP)
      [[ -z "${CONFIG_VALUES[SUB_DOMAIN]+x}" ]] || die "SUBSCRIPTION_MODE=IP 不使用 SUB_DOMAIN"
      SUB_IP="$(required_value SUB_IP)"
      SUB_PORT="$(required_value SUB_PORT)"
      SUB_TOKEN="$(required_value SUB_TOKEN)"
      subscription_ip_family="$(ip_family "$SUB_IP")" || die "订阅 IP 无效：$SUB_IP"
      [[ "$SUB_IP" != "0.0.0.0" && "$SUB_IP" != "::" ]] || die "订阅 IP 不能是未指定地址"
      validate_port "HTTPS 订阅端口" "$SUB_PORT"
      SUB_HOST="$SUB_IP"
      SUB_HOST_FAMILY="$subscription_ip_family"
      SUBSCRIPTION_ENABLED=1
      CERT_REQUIRED=1
      ;;
    *)
      die "SUBSCRIPTION_MODE 只能是 NONE、DOMAIN 或 IP"
      ;;
  esac
  SUBSCRIPTION_MODE="$subscription_mode"
  if (( CERT_REQUIRED == 1 )); then
    [[ -n "$CERT_CONTENT" && -n "$KEY_CONTENT" ]] || die "当前配置需要同时提供证书和私钥"
  fi
  if (( SUBSCRIPTION_ENABLED == 1 )); then
    [[ -z "${used_ports[$SUB_PORT]+x}" ]] || die "订阅端口 $SUB_PORT 与节点 ${used_ports[$SUB_PORT]} 重复"
  fi
  for index in "${HY2_IDS[@]}"; do
    start="${NODE_HY2_STARTS[$index]}"
    end="${NODE_HY2_ENDS[$index]}"
    if (( SUBSCRIPTION_ENABLED == 1 && SUB_PORT >= start && SUB_PORT <= end )); then
      die "订阅端口 $SUB_PORT 落在节点 $index 的 HY2 跳跃范围内"
    fi
    for other in "${NODE_IDS[@]}"; do
      [[ "$other" == "$index" ]] && continue
      port="${NODE_PORTS[$other]}"
      if (( port >= start && port <= end )); then
        die "节点 $other 的端口 $port 落在节点 $index 的 HY2 跳跃范围内"
      fi
    done
    for other in "${HY2_IDS[@]}"; do
      (( other > index )) || continue
      if (( ${NODE_HY2_STARTS[$other]} <= end && ${NODE_HY2_ENDS[$other]} >= start )); then
        die "节点 $index 与节点 $other 的 HY2 跳跃范围重叠"
      fi
    done
  done
  if (( SUBSCRIPTION_ENABLED == 1 )) && [[ "$SUB_TOKEN" != AUTO ]]; then
    [[ "$SUB_TOKEN" =~ ^[A-Za-z0-9_-]{12,64}$ ]] || die "SUB_TOKEN 必须是 AUTO 或 12 到 64 位的字母、数字、_、-"
  fi
}
require_debian_13() {
  [[ -r /etc/os-release ]] || die "无法读取系统发行版信息"
  # shellcheck disable=SC1091
  . /etc/os-release
  [[ "${ID:-}" == "debian" && "${VERSION_ID:-}" == "13" ]] || die "本脚本仅支持 Debian 13"
  command_exists systemctl && [[ -d /run/systemd/system ]] || die "Debian 13 必须运行 systemd"
}

install_dependencies() {
  local -a packages=()
  local nginx_new=0
  command_exists ip || packages+=(iproute2)
  command_exists jq || packages+=(jq)
  command_exists openssl || packages+=(openssl)
  command_exists sha256sum || packages+=(coreutils)
  command_exists curl || packages+=(curl)
  if (( SUBSCRIPTION_ENABLED == 1 )) && ! command_exists nginx; then
    packages+=(nginx)
    nginx_new=1
  fi
  if ! find_xray >/dev/null 2>&1; then
    command_exists unzip || packages+=(unzip)
    [[ -s /etc/ssl/certs/ca-certificates.crt ]] || packages+=(ca-certificates)
  fi
  if (( ${#HY2_IDS[@]} > 0 )); then
    command_exists nft || packages+=(nftables)
  fi
  (( ${#packages[@]} > 0 )) || return 0
  info "只安装缺少的基础工具：${packages[*]}"
  DEBIAN_FRONTEND=noninteractive apt-get update || die "APT 软件源更新失败"
  DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}" || die "基础工具安装失败"
  if (( nginx_new == 1 )); then
    systemctl disable --now nginx.service >/dev/null || die "无法停用新安装的默认 Nginx 服务"
  fi
  command_exists ip && command_exists jq && command_exists openssl &&
  command_exists curl && command_exists sha256sum &&
    { (( SUBSCRIPTION_ENABLED == 0 )) || command_exists nginx; } &&
    { (( ${#HY2_IDS[@]} == 0 )) || command_exists nft; } || die "依赖安装完成后仍缺少必需工具"
}

require_local_addresses() {
  local index field addr family bits found
  for index in "${NODE_IDS[@]}"; do
    [[ "${NODE_TYPES[$index]}" == REALITY || "${NODE_TYPES[$index]}" == HY2 ]] || continue
    for field in ENTRY EXIT; do
      if [[ "$field" == ENTRY ]]; then
        addr="${NODE_ENTRY_IPS[$index]}"
        family="${NODE_IP_FAMILIES[$index]}"
      else
        addr="${NODE_EXIT_IPS[$index]}"
        family="${NODE_EXIT_FAMILIES[$index]}"
      fi
      if [[ "$family" == 6 ]]; then bits=128; else bits=32; fi
      found="$(ip "-$family" -o address show to "$addr/$bits")" || die "无法检查节点 $index 的 ${field}_IP"
      [[ -n "$found" ]] || die "节点 $index 的 ${field}_IP 尚未配置到本机：$addr；请先添加并设置重启后保留"
      [[ "$found" != *tentative* && "$found" != *dadfailed* ]] || die "节点 $index 的 ${field}_IP 尚未就绪：$addr"
    done
  done
  if [[ "$SUBSCRIPTION_MODE" == IP ]]; then
    addr="$SUB_IP"
    family="$SUB_HOST_FAMILY"
    if [[ "$family" == 6 ]]; then bits=128; else bits=32; fi
    found="$(ip "-$family" -o address show to "$addr/$bits")" || die "无法检查订阅 IP：$addr"
    [[ -n "$found" ]] || die "订阅 IP 尚未配置到本机：$addr；请先添加并设置重启后保留"
    [[ "$found" != *tentative* && "$found" != *dadfailed* ]] || die "订阅 IP 尚未就绪：$addr"
  fi
}

find_xray() {
  local candidate
  if command_exists xray; then command -v xray; return; fi
  for candidate in /usr/local/bin/xray /usr/bin/xray /usr/local/sbin/xray; do
    if [[ -x "$candidate" ]]; then printf '%s' "$candidate"; return; fi
  done
  return 1
}
install_xray() {
  local asset
  case "$(uname -m)" in
    x86_64|amd64) asset="Xray-linux-64.zip" ;;
    aarch64|arm64) asset="Xray-linux-arm64-v8a.zip" ;;
    *) die "不支持当前 CPU 架构：$(uname -m)" ;;
  esac
  info "下载 Xray 官方二进制文件"
  curl -fL "https://github.com/XTLS/Xray-core/releases/latest/download/$asset" -o "$TMP_DIR/xray.zip" || die "下载 Xray 失败"
  unzip -p "$TMP_DIR/xray.zip" xray > "$TMP_DIR/xray" || die "解压 Xray 失败"
  install -m 755 "$TMP_DIR/xray" /usr/local/bin/xray || die "安装 Xray 失败"
  /usr/local/bin/xray version >/dev/null 2>&1 || die "安装后的 Xray 无法运行"
}
prepare_certificate() {
  local cert_pub key_pub domain index
  printf '%s\n' "$CERT_CONTENT" > "$TMP_DIR/cert.pem"
  printf '%s\n' "$KEY_CONTENT" > "$TMP_DIR/key.pem"
  openssl x509 -in "$TMP_DIR/cert.pem" -noout >/dev/null 2>&1 || die "证书不是有效的 X.509 PEM"
  openssl pkey -in "$TMP_DIR/key.pem" -passin pass: -noout >/dev/null 2>&1 || die "私钥无效或带有密码"
  if [[ "$SUBSCRIPTION_MODE" == DOMAIN ]]; then
    openssl x509 -in "$TMP_DIR/cert.pem" -noout -checkhost "$SUB_DOMAIN" >/dev/null 2>&1 || die "证书不包含订阅域名：$SUB_DOMAIN"
  elif [[ "$SUBSCRIPTION_MODE" == IP ]]; then
    openssl x509 -in "$TMP_DIR/cert.pem" -noout -checkip "$SUB_IP" >/dev/null 2>&1 || die "证书不包含订阅 IP：$SUB_IP"
  fi
  for index in "${NODE_IDS[@]}"; do
    case "${NODE_TYPES[$index]}" in
      CDN) domain="$(config_value "NODE_${index}_ORIGIN_DOMAIN")" ;;
      HY2) domain="$(config_value "NODE_${index}_SNI")" ;;
      *) continue ;;
    esac
    openssl x509 -in "$TMP_DIR/cert.pem" -noout -checkhost "$domain" >/dev/null 2>&1 || die "证书不包含节点 $index 的域名：$domain"
  done
  cert_pub="$(openssl x509 -in "$TMP_DIR/cert.pem" -pubkey -noout | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | awk '{print $1}')"
  key_pub="$(openssl pkey -in "$TMP_DIR/key.pem" -passin pass: -pubout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | awk '{print $1}')"
  [[ -n "$cert_pub" && "$cert_pub" == "$key_pub" ]] || die "证书和私钥不匹配"
  CERT_SHA256="$(openssl x509 -in "$TMP_DIR/cert.pem" -outform DER | sha256sum | awk '{print $1}')"
  mkdir -p -- "$OUTPUT_DIR"
  CERT_FILE="$OUTPUT_DIR/yijian-origin-cert.pem"
  KEY_FILE="$OUTPUT_DIR/yijian-origin-key.pem"
  install -m 600 "$TMP_DIR/cert.pem" "$CERT_FILE"
  install -m 600 "$TMP_DIR/key.pem" "$KEY_FILE"
}

# 兼容 Xray x25519 的 Private key / PrivateKey 与 Public key / Password 输出。
extract_x25519_value() {
  local kind="$1"
  printf '%s\n' "$KEY_OUTPUT" | awk -v kind="$kind" '
    function emit(value) {
      gsub(/\r/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value != "") { print value; exit }
    }
    {
      for (i = 1; i <= NF; i++) {
        token = $i
        if (kind == "private") {
          if (token == "PrivateKey:" && i < NF) emit($(i + 1))
          if (token ~ /^PrivateKey:[^[:space:]]+$/) {
            sub(/^PrivateKey:/, "", token); emit(token)
          }
          if (token == "Private" && i < NF) {
            next_token = $(i + 1)
            if (next_token == "key:" && i + 1 < NF) emit($(i + 2))
            if (next_token ~ /^key:[^[:space:]]+$/) {
              sub(/^key:/, "", next_token); emit(next_token)
            }
          }
        } else {
          if (token == "Password" && i < NF) {
            next_token = $(i + 1)
            if (next_token == "(PublicKey):" && i + 1 < NF) emit($(i + 2))
            if (next_token ~ /^\(PublicKey\):[^[:space:]]+$/) {
              sub(/^\(PublicKey\):/, "", next_token); emit(next_token)
            }
          }
          if (token == "Password:" && i < NF) emit($(i + 1))
          if (token ~ /^Password:[^[:space:]]+$/) {
            sub(/^Password:/, "", token); emit(token)
          }
          if (token == "PublicKey:" && i < NF) emit($(i + 1))
          if (token ~ /^PublicKey:[^[:space:]]+$/) {
            sub(/^PublicKey:/, "", token); emit(token)
          }
          if (token == "Public" && i < NF) {
            next_token = $(i + 1)
            if (next_token == "key:" && i + 1 < NF) emit($(i + 2))
            if (next_token ~ /^key:[^[:space:]]+$/) {
              sub(/^key:/, "", next_token); emit(next_token)
            }
          }
        }
      }
    }
  '
}

prepare_base_config() {
  TMP_CONFIG="$TMP_DIR/config.json"
  if [[ -e "$CONFIG_PATH" ]]; then
    [[ -f "$CONFIG_PATH" ]] || die "Xray 配置路径不是普通文件：$CONFIG_PATH"
    jq empty "$CONFIG_PATH" >/dev/null 2>&1 || die "现有 Xray 配置不是有效 JSON：$CONFIG_PATH"
    BASE_CONFIG="$CONFIG_PATH"
  else
    BASE_CONFIG="$TMP_DIR/base.json"
    cat > "$BASE_CONFIG" <<'BASE_JSON'
{
  "log": {"loglevel": "warning"},
  "inbounds": [],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct"},
    {"protocol": "blackhole", "tag": "block"}
  ]
}
BASE_JSON
  fi
}

build_nodes() {
  local index prefix type port tag outtag entry exit family name uuid short_id
  local private_key public_key reality_json outbound_json rule_json link listen
  local origin preferred path_enc origin_enc host password sni
  REALITY_SNI="apple.com"
  REALITY_DEST="apple.com:443"
  REALITY_SNI_ENC="$(urlencode "$REALITY_SNI")"
  XHTTP_PATH=""
  path_enc=""
  for index in "${NODE_IDS[@]}"; do
    if [[ "${NODE_TYPES[$index]}" == CDN ]]; then
      XHTTP_PATH="/xhttp-$(openssl rand -hex 6)"
      path_enc="$(urlencode "$XHTTP_PATH")"
      break
    fi
  done

  for index in "${NODE_IDS[@]}"; do
    prefix="NODE_${index}"
    type="${NODE_TYPES[$index]}"
    port="${NODE_PORTS[$index]}"
    name="${NODE_NAMES[$index]}"
    tag="yijian-in-${index}"
    outtag="yijian-out-${index}"
    case "$type" in
      REALITY)
        entry="${NODE_ENTRY_IPS[$index]}"
        exit="${NODE_EXIT_IPS[$index]}"
        family="${NODE_EXIT_FAMILIES[$index]}"
        if [[ "${NODE_IP_FAMILIES[$index]}" == 6 ]]; then listen="::"; else listen="0.0.0.0"; fi
        uuid="$(cat /proc/sys/kernel/random/uuid)"
        short_id="$(openssl rand -hex 8)"
        KEY_OUTPUT="$("$XRAY_BIN" x25519 2>&1)" || die "节点 $index 的 Reality 密钥生成失败"
        private_key="$(extract_x25519_value private)"
        public_key="$(extract_x25519_value public)"
        [[ -n "$private_key" && -n "$public_key" ]] || die "节点 $index 的 Reality 密钥格式无法识别"
        reality_json="$(jq -cn \
          --arg tag "$tag" --arg listen "$listen" --argjson port "$port" \
          --arg uuid "$uuid" --arg dest "$REALITY_DEST" --arg sni "$REALITY_SNI" \
          --arg private_key "$private_key" --arg short_id "$short_id" \
          '{tag:$tag,listen:$listen,port:$port,protocol:"vless",
            settings:{clients:[{id:$uuid,flow:"xtls-rprx-vision"}],decryption:"none"},
            streamSettings:{network:"tcp",security:"reality",
              realitySettings:{show:false,dest:$dest,xver:0,serverNames:[$sni],
                privateKey:$private_key,shortIds:[$short_id]}}}')" || die "节点 $index 的 Reality 配置生成失败"
        NEW_INBOUNDS+=("$reality_json")
        outbound_json="$(jq -cn --arg tag "$outtag" --arg exit "$exit" --arg strategy "UseIPv${family}" \
          '{tag:$tag,protocol:"freedom",sendThrough:$exit,settings:{domainStrategy:$strategy}}')" || die "节点 $index 的出口配置生成失败"
        NEW_OUTBOUNDS+=("$outbound_json")
        host="$(url_host "$entry")"
        link="vless://${uuid}@${host}:${port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SNI_ENC}&fp=chrome&pbk=$(urlencode "$public_key")&sid=${short_id}&type=tcp&headerType=none#$(urlencode "$name")"
        ;;
      CDN)
        preferred="$(config_value "${prefix}_PREFERRED_DOMAIN")"
        origin="$(config_value "${prefix}_ORIGIN_DOMAIN")"
        origin_enc="$(urlencode "$origin")"
        if [[ -s /proc/net/if_inet6 ]]; then listen="::"; else listen="0.0.0.0"; fi
        uuid="$(cat /proc/sys/kernel/random/uuid)"
        reality_json="$(jq -cn \
          --arg tag "$tag" --arg listen "$listen" --argjson port "$port" --arg uuid "$uuid" \
          --arg path "$XHTTP_PATH" \
          --arg cert "$CERT_FILE" --arg key "$KEY_FILE" \
          '{tag:$tag,listen:$listen,port:$port,protocol:"vless",
            settings:{clients:[{id:$uuid}],decryption:"none"},
            streamSettings:{network:"xhttp",security:"tls",
              xhttpSettings:{path:$path,mode:"auto"},
              tlsSettings:{alpn:["h2","http/1.1"],
                certificates:[{certificateFile:$cert,keyFile:$key}]}}}')" || die "节点 $index 的 CDN 配置生成失败"
        NEW_INBOUNDS+=("$reality_json")
        outbound_json="$(jq -cn --arg tag "$outtag" \
          '{tag:$tag,protocol:"freedom",settings:{domainStrategy:"AsIs"}}')" || die "节点 $index 的出口配置生成失败"
        NEW_OUTBOUNDS+=("$outbound_json")
        link="vless://${uuid}@${preferred}:${port}?encryption=none&security=tls&sni=${origin_enc}&host=${origin_enc}&type=xhttp&path=${path_enc}&mode=auto#$(urlencode "$name")"
        ;;
      HY2)
        entry="${NODE_ENTRY_IPS[$index]}"
        exit="${NODE_EXIT_IPS[$index]}"
        family="${NODE_EXIT_FAMILIES[$index]}"
        if [[ "${NODE_IP_FAMILIES[$index]}" == 6 ]]; then listen="::"; else listen="0.0.0.0"; fi
        sni="$(config_value "${prefix}_SNI")"
        password="${NODE_HY2_PASSWORDS[$index]}"
        reality_json="$(jq -cn \
          --arg tag "$tag" --arg listen "$listen" --argjson port "$port" \
          --arg auth "$password" --arg cert "$CERT_FILE" --arg key "$KEY_FILE" \
          '{tag:$tag,listen:$listen,port:$port,protocol:"hysteria",
            settings:{version:2,users:[{auth:$auth}]},
            streamSettings:{method:"hysteria",security:"tls",
              hysteriaSettings:{version:2},
              tlsSettings:{alpn:["h3"],certificates:[{certificateFile:$cert,keyFile:$key}]}}}')" || die "节点 $index 的 HY2 配置生成失败"
        NEW_INBOUNDS+=("$reality_json")
        outbound_json="$(jq -cn --arg tag "$outtag" --arg exit "$exit" --arg strategy "UseIPv${family}" \
          '{tag:$tag,protocol:"freedom",sendThrough:$exit,settings:{domainStrategy:$strategy}}')" || die "节点 $index 的出口配置生成失败"
        NEW_OUTBOUNDS+=("$outbound_json")
        host="$(url_host "$entry")"
        link="hysteria2://$(urlencode "$password")@${host}:${port}?security=tls&alpn=h3&insecure=0&allowInsecure=0&mport=${NODE_HY2_STARTS[$index]}-${NODE_HY2_ENDS[$index]}&sni=$(urlencode "$sni")&pinSHA256=${CERT_SHA256}#$(urlencode "$name")"
        ;;
    esac
    rule_json="$(jq -cn --arg inbound "$tag" --arg outbound "$outtag" \
      '{type:"field",inboundTag:[$inbound],outboundTag:$outbound}')" || die "节点 $index 的路由生成失败"
    NEW_RULES+=("$rule_json")
    NODE_LINES+=("$link")
  done
}

merge_xray_config() {
  local inbounds_json outbounds_json rules_json
  inbounds_json="$(printf '%s\n' "${NEW_INBOUNDS[@]}" | jq -s '.')" || die "合并入站失败"
  outbounds_json="$(printf '%s\n' "${NEW_OUTBOUNDS[@]}" | jq -s '.')" || die "合并出站失败"
  rules_json="$(printf '%s\n' "${NEW_RULES[@]}" | jq -s '.')" || die "合并路由失败"

  jq --argjson new_inbounds "$inbounds_json" \
     --argjson new_outbounds "$outbounds_json" \
     --argjson new_rules "$rules_json" '
    def managed_inbound:
      . == "vless-reality-vision" or . == "vless-xhttp-tls" or
      (. | test("^yijian-in-[1-9][0-9]*$"));
    def managed_outbound: . | test("^yijian-out-[1-9][0-9]*$");
    .inbounds = ((.inbounds // []) |
      map(select(((.tag // "") | managed_inbound) | not)) + $new_inbounds)
    | .outbounds = ((.outbounds // []) |
      map(select(((.tag // "") | managed_outbound) | not)) + $new_outbounds)
    | .routing = (.routing // {})
    | .routing.rules = ($new_rules + ((.routing.rules // []) |
      map(select((any(.inboundTag[]?; managed_inbound) or
        ((.outboundTag // "") | managed_outbound)) | not))))
  ' "$BASE_CONFIG" > "$TMP_CONFIG" || die "生成 Xray 配置失败"
  jq empty "$TMP_CONFIG" >/dev/null 2>&1 || die "生成的 Xray 配置不是有效 JSON"
  if ! "$XRAY_BIN" run -test -c "$TMP_CONFIG" > "$TMP_DIR/xray-test.log" 2>&1; then
    cat "$TMP_DIR/xray-test.log" >&2
    die "Xray 配置检查失败；请确认 Xray 版本支持 HY2 和 XHTTP"
  fi
}

configure_hy2_hop_service() {
  local nft_bin index
  if (( ${#HY2_IDS[@]} == 0 )); then
    if [[ -f /etc/systemd/system/xray-yijian-hy2-hop.service ]]; then
      systemctl disable --now xray-yijian-hy2-hop.service >/dev/null || die "无法停用旧的 HY2 跳跃服务"
    fi
    if command_exists nft && nft list table inet xray_yijian_hy2 >/dev/null 2>&1; then
      nft delete table inet xray_yijian_hy2 || die "无法清除旧的 HY2 跳跃规则"
    fi
    return
  fi

  nft_bin="$(command -v nft)" || die "找不到 nftables"
  cat > "$OUTPUT_DIR/yijian-hy2-hop.nft" <<'NFT_HEADER'
table inet xray_yijian_hy2 {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
NFT_HEADER
  for index in "${HY2_IDS[@]}"; do
    if [[ "${NODE_IP_FAMILIES[$index]}" == 6 ]]; then
      printf '    ip6 daddr %s udp dport %s-%s redirect to :%s\n' \
        "${NODE_ENTRY_IPS[$index]}" "${NODE_HY2_STARTS[$index]}" "${NODE_HY2_ENDS[$index]}" "${NODE_HY2_STARTS[$index]}" \
        >> "$OUTPUT_DIR/yijian-hy2-hop.nft"
    else
      printf '    ip daddr %s udp dport %s-%s redirect to :%s\n' \
        "${NODE_ENTRY_IPS[$index]}" "${NODE_HY2_STARTS[$index]}" "${NODE_HY2_ENDS[$index]}" "${NODE_HY2_STARTS[$index]}" \
      >> "$OUTPUT_DIR/yijian-hy2-hop.nft"
    fi
  done
  cat >> "$OUTPUT_DIR/yijian-hy2-hop.nft" <<'NFT_FOOTER'
  }
}
NFT_FOOTER
  cat > /etc/systemd/system/xray-yijian-hy2-hop.service <<EOF
[Unit]
Description=Xray yijian HY2 UDP port hopping
After=nftables.service
Before=xray-yijian.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-$nft_bin delete table inet xray_yijian_hy2
ExecStart=$nft_bin -f $OUTPUT_DIR/yijian-hy2-hop.nft
ExecStop=-$nft_bin delete table inet xray_yijian_hy2

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload || die "systemd 配置加载失败"
  systemctl enable xray-yijian-hy2-hop.service >/dev/null || die "无法启用 HY2 跳跃服务"
  systemctl restart xray-yijian-hy2-hop.service || die "无法应用 HY2 跳跃规则"
  systemctl is-active --quiet xray-yijian-hy2-hop.service || die "HY2 跳跃服务没有运行"
}
start_xray_service() {
  local unit_wants="network-online.target"
  local unit_after="network-online.target"
  if (( ${#HY2_IDS[@]} > 0 )); then
    unit_wants+=" xray-yijian-hy2-hop.service"
    unit_after+=" xray-yijian-hy2-hop.service"
  fi
  cat > /etc/systemd/system/xray-yijian.service <<EOF
[Unit]
Description=Xray yijian node service
Wants=$unit_wants
After=$unit_after

[Service]
Type=simple
ExecStart=$XRAY_BIN run -c $CONFIG_PATH

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload || die "systemd 配置加载失败"
  systemctl enable xray-yijian.service >/dev/null || die "无法启用 Xray 自启动"
  systemctl restart xray-yijian.service || die "Xray 启动失败"
  sleep 1
  systemctl is-active --quiet xray-yijian.service || die "Xray 服务没有运行"
}

write_subscription_files() {
  if [[ "$SUB_TOKEN" == "AUTO" ]]; then SUB_TOKEN="$(openssl rand -hex 16)"; fi
  SUB_DIR="$SUB_ROOT/$SUB_TOKEN"
  SUB_FILE="$SUB_DIR/jhsub.txt"
  mkdir -p -- "$SUB_DIR"
  printf '%s\n' "${NODE_LINES[@]}" > "$OUTPUT_DIR/vless-links.txt"
  printf '%s\n' "${NODE_LINES[@]}" > "$SUB_FILE"
  chmod 600 "$OUTPUT_DIR/vless-links.txt"
  id www-data >/dev/null 2>&1 || die "找不到 Debian Nginx 的 www-data 用户"
  chown root:www-data "$(dirname "$SUB_ROOT")" "$SUB_ROOT" "$SUB_DIR" "$SUB_FILE" || die "无法设置订阅文件属主"
  chmod 750 "$(dirname "$SUB_ROOT")" "$SUB_ROOT" "$SUB_DIR"
  chmod 640 "$SUB_FILE"
  if [[ "$SUBSCRIPTION_MODE" == "IP" ]]; then
    SUB_URL_HOST="$(url_host "$SUB_IP")"
  else
    SUB_URL_HOST="$SUB_DOMAIN"
  fi
  if [[ "$SUB_PORT" == "443" ]]; then
    SUB_URL="https://${SUB_URL_HOST}/${SUB_TOKEN}/jhsub.txt"
  else
    SUB_URL="https://${SUB_URL_HOST}:${SUB_PORT}/${SUB_TOKEN}/jhsub.txt"
  fi
  printf '%s\n' "$SUB_URL" > "$OUTPUT_DIR/yijian-subscription-url.txt"
  chmod 600 "$OUTPUT_DIR/yijian-subscription-url.txt"
}

start_subscription_service() {
  NGINX_BIN="$(command -v nginx)" || die "找不到 Nginx"
  local nginx_conf="$OUTPUT_DIR/yijian-subscription-nginx.conf"
  local ipv6_listen=""
  local server_name="$SUB_HOST"
  local listen_address=""
  if [[ "$SUBSCRIPTION_MODE" == IP ]]; then
    server_name="_"
    if [[ "$SUB_HOST_FAMILY" == 6 ]]; then
      ipv6_listen="        listen [$SUB_IP]:$SUB_PORT ssl ipv6only=on;"
    else
      ipv6_listen=""
    fi
    listen_address="$SUB_IP"
  else
    listen_address="0.0.0.0"
  fi
  if [[ "$SUBSCRIPTION_MODE" != IP && -s /proc/net/if_inet6 ]]; then
    ipv6_listen="        listen [::]:$SUB_PORT ssl ipv6only=on;"
  fi
  cat > "$nginx_conf" <<EOF
user www-data;
daemon off;
worker_processes 1;
pid /run/xray-yijian-sub-nginx.pid;
error_log /var/log/xray-yijian-sub.log warn;

events {
    worker_connections 128;
}

http {
    access_log off;
    sendfile on;
    server {
        listen $listen_address:$SUB_PORT ssl;
$ipv6_listen
        server_name $server_name;
        ssl_certificate $CERT_FILE;
        ssl_certificate_key $KEY_FILE;
        ssl_protocols TLSv1.2 TLSv1.3;

        location = /$SUB_TOKEN/jhsub.txt {
            root $SUB_ROOT;
            default_type text/plain;
            add_header Cache-Control "no-store" always;
        }
        location / { return 404; }
    }
}
EOF
  chmod 600 "$nginx_conf" || die "无法保护订阅服务配置"
  "$NGINX_BIN" -t -c "$nginx_conf" || die "Nginx HTTPS 订阅配置检查失败"
  cat > /etc/systemd/system/xray-yijian-sub.service <<EOF
[Unit]
Description=Xray yijian HTTPS subscription
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$NGINX_BIN -c $nginx_conf
ExecStop=$NGINX_BIN -c $nginx_conf -s quit

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload || die "systemd 配置加载失败"
  systemctl enable xray-yijian-sub.service >/dev/null || die "无法启用订阅服务自启动"
  systemctl restart xray-yijian-sub.service || die "HTTPS 订阅服务启动失败"
  systemctl is-active --quiet xray-yijian-sub.service || die "HTTPS 订阅服务没有运行"
}

verify_subscription() {
  local local_url="https://${SUB_URL_HOST}:${SUB_PORT}/${SUB_TOKEN}/jhsub.txt"
  local resolve_spec="${SUB_URL_HOST}:${SUB_PORT}:127.0.0.1"
  local expected actual
  if [[ "$SUBSCRIPTION_MODE" == IP && "$SUB_HOST_FAMILY" == 6 ]]; then
    local_url="https://[$SUB_IP]:${SUB_PORT}/${SUB_TOKEN}/jhsub.txt"
    resolve_spec="[$SUB_IP]:${SUB_PORT}:[::1]"
  fi
  expected="$(cat "$SUB_FILE")"
  actual="$(curl -fsSk --noproxy '*' --max-time 8 \
    --resolve "$resolve_spec" "$local_url" 2>/dev/null)" ||
    die "本机 HTTPS 订阅检查失败"
  [[ "$actual" == "$expected" ]] || die "本机 HTTPS 订阅内容与节点文件不一致"
}

show_port_usage() {
  if command_exists ss; then ss -lntup; else printf '未找到 ss，无法显示端口占用\n'; fi
}
show_deployment() {
  local output_dir="${1:-$OUTPUT_DIR}" line count=0
  local link_file="$output_dir/vless-links.txt"
  local url_file="$output_dir/yijian-subscription-url.txt"
  [[ -s "$link_file" ]] || die "找不到已生成的节点文件"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    count=$((count + 1))
    printf '节点 %s：%s\n' "$count" "$line"
  done < "$link_file"
  printf '节点总数：%s\n' "$count"
  if [[ -s "$url_file" ]]; then
    printf 'HTTPS 订阅：%s\n' "$(head -n 1 "$url_file")"
  else
    printf 'HTTPS 订阅：未启用\n'
  fi
  show_port_usage
}

main() {
  [[ "$(id -u)" -eq 0 ]] || die "请使用 root 运行此脚本"
  if [[ "${1:-}" == "show" ]]; then
    show_deployment "${2:-$OUTPUT_DIR}"
    return
  fi
  [[ -z "${1:-}" ]] || die "未知参数：$1；可用参数为 show [输出目录]"
  require_debian_13
  printf 'Debian 13 子网节点一键部署 %s\n' "$SCRIPT_VERSION"
  read_deployment_config
  validate_deployment_config
  TMP_DIR="$(mktemp -d /tmp/xray-yijian.XXXXXX)" || die "无法创建临时目录"
  install_dependencies
  require_local_addresses
  XRAY_BIN="$(find_xray || true)"
  if [[ -z "$XRAY_BIN" ]]; then
    install_xray
    XRAY_BIN="$(find_xray || true)"
  fi
  [[ -n "$XRAY_BIN" ]] || die "安装后仍找不到 Xray"
  for index in "${HY2_IDS[@]}"; do
    if [[ "${NODE_HY2_PASSWORDS[$index]}" == AUTO ]]; then
      NODE_HY2_PASSWORDS[$index]="$(openssl rand -hex 16)"
    fi
  done
  if (( CERT_REQUIRED == 1 )); then
    prepare_certificate
  fi
  prepare_base_config
  build_nodes
  merge_xray_config
  install -m 600 "$TMP_CONFIG" "$CONFIG_PATH"
  configure_hy2_hop_service
  start_xray_service
  if (( SUBSCRIPTION_ENABLED == 1 )); then
    write_subscription_files
    start_subscription_service
    verify_subscription
  else
    printf '%s\n' "${NODE_LINES[@]}" > "$OUTPUT_DIR/vless-links.txt"
    chmod 600 "$OUTPUT_DIR/vless-links.txt"
    rm -f -- "$OUTPUT_DIR/yijian-subscription-url.txt"
    if [[ -f /etc/systemd/system/xray-yijian-sub.service ]]; then
      systemctl disable --now xray-yijian-sub.service >/dev/null || die "无法停用旧的 HTTPS 订阅服务"
    fi
  fi
  if (( SUBSCRIPTION_ENABLED == 1 )); then
    ok "${#NODE_IDS[@]} 个节点和 HTTPS 订阅已部署"
  else
    ok "${#NODE_IDS[@]} 个节点已部署，HTTPS 订阅未启用"
  fi
  printf '%s\n' "${NODE_LINES[@]}"
  if (( SUBSCRIPTION_ENABLED == 1 )); then
    printf '订阅网址：%s\n' "$SUB_URL"
  else
    printf '订阅网址：未启用\n'
  fi
  for index in "${HY2_IDS[@]}"; do
    printf '节点 %s 的 HY2 UDP 跳跃范围：%s:%s\n' "$index" "${NODE_HY2_STARTS[$index]}" "${NODE_HY2_ENDS[$index]}"
  done
  printf '节点文件：%s/vless-links.txt\n' "$OUTPUT_DIR"
}

main "$@"
